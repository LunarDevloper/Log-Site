# API para onde o proxy /api aponta no `npm run dev` (vite.config.js).
# No navegador o site sempre chama /api do próprio domínio; em produção
# o repasse é feito pelo vercel.json. Só um app aberto via file:// usa direto.
VITE_API_URL=https://buddylog-rosy.vercel.app

# Endereço público do site, usado nos links de convite (opcional)
VITE_SITE_URL=
